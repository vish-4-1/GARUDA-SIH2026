# GARUDA Environment Configuration
PROJECT_NAME="GARUDA Threat Simulation Trainer"
API_V1_STR=/api
ENVIRONMENT=development
DEBUG=True

# Database Configuration (Defaults to SQLite for lightweight local dev; switch to PostgreSQL for Docker)
DATABASE_URL=sqlite:///./garuda.db
# DATABASE_URL=postgresql://garuda:garudapass@localhost:5432/garudadb

# Postgres credentials (for Docker Compose)
POSTGRES_USER=garuda
POSTGRES_PASSWORD=garudapass
POSTGRES_DB=garudadb
