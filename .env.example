# GARUDA — AI-Enabled Drone & Counter-Drone Threat Simulation Trainer
# Environment Configuration Template

PROJECT_NAME="GARUDA Threat Simulation Trainer"
API_V1_STR=/api
ENVIRONMENT=development
DEBUG=True

# Database Configuration
# Default single-instance development uses persistent SQLite storage
DATABASE_URL=sqlite:///./garuda.db
# In Docker Compose, the SQLite database is persisted in a named volume:
# DATABASE_URL=sqlite:////app/data/garuda.db

# Frontend / WebSocket Configuration
# For local development with Vite dev server (auto-proxies /api and /api/ws)
VITE_API_BASE_URL=/api
# Optional direct WebSocket URL override (defaults to same host with ws:// protocol)
# VITE_WS_BASE_URL=ws://127.0.0.1:8000

# Optional External Adapters (Keep disabled unless external hardware/SITL simulator is running)
PX4_SITL_UDP_PORT=14540
PX4_SITL_HOST=127.0.0.1
ROS2_DDS_DOMAIN_ID=0
